# ---- Required for real YouTube search / trending ----
# Create a key at https://console.cloud.google.com/ with "YouTube Data API v3" enabled.
# This value is read ONLY on the server and is never sent to the browser.
YOUTUBE_API_KEY=

# Region used for the Trending chart (ISO 3166-1 alpha-2).
YOUTUBE_REGION=US

# ---- Session signing secret (required in production) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# ---- Optional ----
# Absolute or relative path for the SQLite database file.
DATABASE_PATH=./data/resonate.db
